# Copy to .env.local for local builds; on Vercel set these as Environment Variables instead.
# Supabase → Project Settings → API (or "Connect"): Project URL and the anon / publishable key.
# Never put the service_role / secret key here – it is shipped to every browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
